# Smooth Operator Development Environment Variables

# OpenAI Configuration
# REQUIRED: Set your OpenAI API key for LLM integration
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Prometheus Configuration
# Uncomment to enable Prometheus metrics collection
# PROMETHEUS_ADDRESS=http://prometheus-k8s.monitoring.svc:9090
# PROMETHEUS_ENABLED=true

# Optional: Loki Configuration  
# Uncomment to enable Loki log aggregation
# LOKI_ADDRESS=http://loki.monitoring.svc:3100
# LOKI_ENABLED=true

# Development Settings
# Set log level: debug, info, warn, error
LOG_LEVEL=debug

# Kubernetes Context (automatically uses current context from kubeconfig)
# The operator will connect to the cluster at 192.168.0.3